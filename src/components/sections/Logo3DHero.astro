---
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";
import type { Lang } from "@/lib/i18n";

export interface Props {
  eyebrow: string;
  headlineHtml: string;
  lede: string;
  signoff?: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  lang: Lang;
}

const { eyebrow, headlineHtml, lede, signoff, ctaPrimary, ctaSecondary, lang } = Astro.props;

const valores = (await getCollection("valores")).sort((a, b) => a.data.orden - b.data.orden);
const valoresLabel = lang === "es" ? "Nuestros valores" : "Our values";
const dragHint = lang === "es" ? "Arrastra para girar" : "Drag to rotate";
---

<section class="hero-3d">
  <div class="container hero-3d-grid">
    <div class="hero-3d-text">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 class="h1 h1-mixed-case hero-headline" set:html={headlineHtml} data-reveal data-reveal-delay="1" />
      <p class="lede" data-reveal data-reveal-delay="2">{lede}</p>
      {signoff && <span class="signoff" data-reveal data-reveal-delay="3">— {signoff}</span>}
      <div class="cta-row" data-reveal data-reveal-delay="4">
        <Button variant="primary" size="lg" href={ctaPrimary.href}>{ctaPrimary.label}</Button>
        {ctaSecondary && <Button variant="ghost" href={ctaSecondary.href}>{ctaSecondary.label}</Button>}
      </div>
    </div>

    <div class="hero-3d-side" data-reveal data-reveal-delay="2">
      <div class="logo-3d-stage">
        <canvas id="logo-3d-canvas" aria-label="Innovational TMS · Talent Management Solutions — interactive 3D logo"></canvas>
        <noscript>
          <div class="logo-3d-fallback">
            <span class="brand-mark">innovational</span>
            <span class="brand-dot">·</span>
            <span class="brand-name">TMS</span>
            <p class="brand-expansion">Talent Management Solutions</p>
          </div>
        </noscript>
        <span class="drag-hint" aria-hidden="true">{dragHint}</span>
      </div>

      <div class="logo-3d-meta">
        <p class="brand-expansion-line">Talent Management Solutions</p>
        <div class="values">
          <span class="values-label">{valoresLabel}</span>
          <ul class="values-list">
            {valores.map((v) => (
              <li>
                <span class="num">{String(v.data.orden).padStart(2, "0")}</span>
                <span class="name">{lang === "es" ? v.data.nombre_es : v.data.nombre_en}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Lazy-load three.js only when the canvas is in viewport
  const canvas = document.getElementById("logo-3d-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const init = async () => {
      const THREE = await import("three");
      const { OrbitControls } = await import("three/examples/jsm/controls/OrbitControls.js");
      const { FontLoader } = await import("three/examples/jsm/loaders/FontLoader.js");
      const { TextGeometry } = await import("three/examples/jsm/geometries/TextGeometry.js");

      const scene = new THREE.Scene();

      const getSize = () => {
        const rect = canvas.getBoundingClientRect();
        return { w: rect.width || 400, h: rect.height || 400 };
      };
      const { w, h } = getSize();

      const camera = new THREE.PerspectiveCamera(40, w / h, 0.1, 100);
      camera.position.set(0, 0.2, 6);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(w, h, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Lighting
      scene.add(new THREE.AmbientLight(0xffffff, 0.45));
      const keyLight = new THREE.DirectionalLight(0xffffff, 1.1);
      keyLight.position.set(3, 4, 5);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0xff7740, 0.85);
      rimLight.position.set(-3, 1, -3);
      scene.add(rimLight);
      const fillLight = new THREE.DirectionalLight(0x6090ff, 0.25);
      fillLight.position.set(-2, -3, 2);
      scene.add(fillLight);

      const group = new THREE.Group();
      scene.add(group);

      const loader = new FontLoader();
      loader.load("/fonts/helvetiker_bold.typeface.json", (font) => {
        const textGeo = new TextGeometry("TMS", {
          font,
          size: 1.3,
          depth: 0.45,
          curveSegments: 14,
          bevelEnabled: true,
          bevelThickness: 0.06,
          bevelSize: 0.05,
          bevelOffset: 0,
          bevelSegments: 6,
        });
        textGeo.center();

        const material = new THREE.MeshStandardMaterial({
          color: 0xef5a21,
          metalness: 0.55,
          roughness: 0.28,
        });

        const textMesh = new THREE.Mesh(textGeo, material);
        group.add(textMesh);

        // Subtle rim plane behind for depth
        const ringGeo = new THREE.TorusGeometry(2.2, 0.025, 8, 64);
        const ringMat = new THREE.MeshStandardMaterial({
          color: 0xef5a21,
          metalness: 0.6,
          roughness: 0.4,
          transparent: true,
          opacity: 0.45,
        });
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.rotation.x = Math.PI / 2.4;
        ring.position.z = -0.6;
        group.add(ring);

        // Innovational dot — small sphere accent
        const dotGeo = new THREE.SphereGeometry(0.12, 24, 24);
        const dotMat = new THREE.MeshStandardMaterial({
          color: 0xef5a21,
          emissive: 0xef5a21,
          emissiveIntensity: 0.55,
          metalness: 0.2,
          roughness: 0.3,
        });
        const dot = new THREE.Mesh(dotGeo, dotMat);
        dot.position.set(-1.85, 0, 0.25);
        group.add(dot);
      });

      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.enableZoom = false;
      controls.enablePan = false;
      controls.rotateSpeed = 0.7;
      controls.autoRotate = !reduced;
      controls.autoRotateSpeed = 0.9;
      // Limit vertical drag so the text stays readable
      controls.minPolarAngle = Math.PI * 0.25;
      controls.maxPolarAngle = Math.PI * 0.75;

      // Stop autorotate while user drags
      controls.addEventListener("start", () => { controls.autoRotate = false; });
      let resumeTimer: number | undefined;
      controls.addEventListener("end", () => {
        if (reduced) return;
        if (resumeTimer) window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { controls.autoRotate = true; }, 2500);
      });

      const onResize = () => {
        const { w, h } = getSize();
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
      };
      window.addEventListener("resize", onResize);

      const animate = () => {
        controls.update();
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      };
      animate();
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            observer.disconnect();
            init().catch((err) => console.warn("3D logo failed to init:", err));
            break;
          }
        }
      }, { rootMargin: "100px" });
      observer.observe(canvas);
    } else {
      init().catch(() => {});
    }
  }
</script>

<style>
  .hero-3d {
    background: var(--ink);
    color: var(--white);
    padding: 120px 0 96px;
    position: relative;
    overflow: hidden;
  }
  .hero-3d::before {
    content: "";
    position: absolute;
    right: -180px;
    top: -120px;
    width: 600px;
    height: 600px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(239, 90, 33, 0.30), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-3d::after {
    content: "";
    position: absolute;
    left: -200px;
    bottom: -200px;
    width: 480px;
    height: 480px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(64, 95, 110, 0.42), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-3d-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
  }
  @media (max-width: 900px) { .hero-3d-grid { grid-template-columns: 1fr; gap: 40px; } }

  .hero-headline { margin: 14px 0 0; }
  .lede { margin-top: 20px; max-width: 560px; }
  .cta-row { margin-top: 28px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }

  .hero-3d-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .logo-3d-stage {
    position: relative;
    aspect-ratio: 4 / 5;
    background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%);
    border: 1px solid var(--hairline);
    border-radius: 0;
    overflow: hidden;
  }
  #logo-3d-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  #logo-3d-canvas:active { cursor: grabbing; }

  .logo-3d-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-weight: 700;
    color: var(--on-dark);
  }
  .logo-3d-fallback .brand-mark { font-size: 32px; letter-spacing: -0.02em; }
  .logo-3d-fallback .brand-dot { color: var(--orange); font-size: 32px; margin: 0 6px; }
  .logo-3d-fallback .brand-name { font-size: 32px; letter-spacing: -0.02em; }
  .logo-3d-fallback .brand-expansion {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    font-weight: 700;
    margin-top: 8px;
  }

  .drag-hint {
    position: absolute;
    bottom: 14px;
    right: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    background: rgba(0, 0, 0, 0.55);
    padding: 6px 10px;
    border: 1px solid var(--hairline);
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  .logo-3d-meta {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 18px 20px;
    background: var(--surface-card);
    border: 1px solid var(--hairline);
  }
  .brand-expansion-line {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--orange);
    font-weight: 700;
    margin: 0;
  }
  .values-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .values-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .values-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
    color: var(--body-strong);
  }
  .values-list .num {
    font-size: 10px;
    color: var(--orange);
    font-weight: 700;
    letter-spacing: 1.5px;
    min-width: 22px;
  }
  .values-list .name {
    font-weight: 700;
    color: var(--on-dark);
  }

  @media (max-width: 600px) {
    .hero-3d { padding: 64px 0 56px; }
    .hero-3d::before { width: 360px; height: 360px; right: -120px; top: -80px; }
    .hero-3d::after { width: 320px; height: 320px; left: -120px; bottom: -120px; }
    .hero-3d-grid { gap: 32px; }
    .lede { margin-top: 16px; }
    .cta-row { margin-top: 22px; gap: 10px; }
    .logo-3d-stage { aspect-ratio: 1 / 1; }
    .drag-hint { font-size: 9px; padding: 4px 8px; }
    .logo-3d-meta { padding: 16px; gap: 14px; }
    .values-list li { font-size: 13px; }
  }
</style>

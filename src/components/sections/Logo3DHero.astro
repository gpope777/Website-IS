---
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";
import type { Lang } from "@/lib/i18n";

export interface Props {
  eyebrow: string;
  headlineHtml: string;
  lede: string;
  signoff?: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  lang: Lang;
}

const { eyebrow, headlineHtml, lede, signoff, ctaPrimary, ctaSecondary, lang } = Astro.props;

const valores = (await getCollection("valores")).sort((a, b) => a.data.orden - b.data.orden);
const valoresLabel = lang === "es" ? "Cinco valores que orbitan la firma" : "Five values orbiting the firm";
const dragHint = lang === "es" ? "Arrastra para girar" : "Drag to rotate";
const valuesData = valores.map((v) => (lang === "es" ? v.data.nombre_es : v.data.nombre_en));
---

<section class="hero-3d">
  <div class="container hero-3d-grid">
    <div class="hero-3d-text">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 class="h1 h1-mixed-case hero-headline" set:html={headlineHtml} data-reveal data-reveal-delay="1" />
      <p class="lede" data-reveal data-reveal-delay="2">{lede}</p>
      {signoff && <span class="signoff" data-reveal data-reveal-delay="3">— {signoff}</span>}
      <div class="cta-row" data-reveal data-reveal-delay="4">
        <Button variant="primary" size="lg" href={ctaPrimary.href}>{ctaPrimary.label}</Button>
        {ctaSecondary && <Button variant="ghost" href={ctaSecondary.href}>{ctaSecondary.label}</Button>}
      </div>
    </div>

    <div class="hero-3d-side" data-reveal data-reveal-delay="2">
      <div class="logo-3d-stage">
        <canvas
          id="logo-3d-canvas"
          aria-label="Innovational TMS · Talent Management Solutions — interactive 3D logo with orbiting values"
          data-values={JSON.stringify(valuesData)}
        ></canvas>
        <noscript>
          <div class="logo-3d-fallback">
            <ul class="fallback-letters">
              {"INNOVATIONAL".split("").map((l, i) => (
                <li class={i % 2 === 0 ? "tile tile-orange" : "tile tile-navy"}>{l}</li>
              ))}
            </ul>
            <p class="brand-expansion">Talent Management Solutions</p>
            <ul class="fallback-values">
              {valuesData.map((v) => <li>{v}</li>)}
            </ul>
          </div>
        </noscript>
        <span class="drag-hint" aria-hidden="true">{dragHint}</span>
        <span class="logo-tag" aria-hidden="true">talent management solutions</span>
      </div>

      <p class="values-caption">{valoresLabel}</p>
    </div>
  </div>
</section>

<script>
  // Lazy-load three.js only when the canvas is in viewport
  const canvas = document.getElementById("logo-3d-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let valuesList: string[] = [];
    try {
      valuesList = JSON.parse(canvas.dataset.values || "[]");
    } catch (e) {
      valuesList = [];
    }

    const init = async () => {
      const THREE = await import("three");
      const { OrbitControls } = await import("three/examples/jsm/controls/OrbitControls.js");
      const { FontLoader } = await import("three/examples/jsm/loaders/FontLoader.js");
      const { TextGeometry } = await import("three/examples/jsm/geometries/TextGeometry.js");

      const scene = new THREE.Scene();

      const getSize = () => {
        const rect = canvas.getBoundingClientRect();
        return { w: rect.width || 400, h: rect.height || 400 };
      };
      const { w, h } = getSize();

      const camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
      camera.position.set(0.6, 0.3, 7.6);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(w, h, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Brand palette
      const ORANGE = 0xef5a21;
      const NAVY = 0x2c4a5b;

      // Lighting — three-point setup that pops the alternating discs
      scene.add(new THREE.AmbientLight(0xffffff, 0.55));
      const keyLight = new THREE.DirectionalLight(0xffffff, 1.15);
      keyLight.position.set(3, 4, 5);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0xff7740, 0.75);
      rimLight.position.set(-4, 2, -3);
      scene.add(rimLight);
      const fillLight = new THREE.DirectionalLight(0x6090ff, 0.3);
      fillLight.position.set(-2, -3, 2);
      scene.add(fillLight);

      // Master group — the user rotates this with OrbitControls
      const group = new THREE.Group();
      scene.add(group);

      // Sub-group for value labels orbiting around the column
      const valuesOrbit = new THREE.Group();
      group.add(valuesOrbit);

      // Track text labels for per-frame billboarding (always face camera)
      const labelMeshes: any[] = [];

      const loader = new FontLoader();
      loader.load("/fonts/helvetiker_bold.typeface.json", (font) => {
        // ----------------------------------------------------------------
        // STACKED COLUMN: "INNOVATIONAL" as alternating discs + letters
        // ----------------------------------------------------------------
        const letters = "INNOVATIONAL".split("");
        const tokenRadius = 0.44;
        const tokenDepth = 0.22;
        const tokenSpacing = 0.34;
        const totalH = (letters.length - 1) * tokenSpacing;

        const tokenWorldPositions: { vec: any; isOrange: boolean }[] = [];
        const letterMat = new THREE.MeshStandardMaterial({
          color: 0xffffff,
          metalness: 0.15,
          roughness: 0.38,
        });

        letters.forEach((letter, i) => {
          const isOrange = i % 2 === 0;
          const yPos = totalH / 2 - i * tokenSpacing;

          // Disc (cylinder rotated to face camera)
          const discGeo = new THREE.CylinderGeometry(tokenRadius, tokenRadius, tokenDepth, 48);
          const discMat = new THREE.MeshStandardMaterial({
            color: isOrange ? ORANGE : NAVY,
            metalness: 0.45,
            roughness: 0.42,
          });
          const disc = new THREE.Mesh(discGeo, discMat);
          disc.rotation.x = Math.PI / 2; // face +Z
          disc.position.set(0, yPos, 0);
          group.add(disc);

          // Front letter — slightly raised
          const letterGeoFront = new TextGeometry(letter, {
            font,
            size: 0.32,
            depth: 0.05,
            curveSegments: 8,
            bevelEnabled: true,
            bevelThickness: 0.012,
            bevelSize: 0.01,
            bevelSegments: 3,
          });
          letterGeoFront.center();
          const letterFront = new THREE.Mesh(letterGeoFront, letterMat);
          letterFront.position.set(0, yPos, tokenDepth / 2 + 0.025);
          group.add(letterFront);

          // Back letter — also visible from behind
          const letterGeoBack = new TextGeometry(letter, {
            font,
            size: 0.32,
            depth: 0.05,
            curveSegments: 8,
            bevelEnabled: true,
            bevelThickness: 0.012,
            bevelSize: 0.01,
            bevelSegments: 3,
          });
          letterGeoBack.center();
          const letterBack = new THREE.Mesh(letterGeoBack, letterMat);
          letterBack.position.set(0, yPos, -(tokenDepth / 2 + 0.025));
          letterBack.rotation.y = Math.PI; // face -Z
          group.add(letterBack);

          tokenWorldPositions.push({
            vec: new THREE.Vector3(0, yPos, tokenDepth / 2),
            isOrange,
          });
        });

        // ----------------------------------------------------------------
        // NETWORK LINES — graph-like connections between tokens (right side)
        // ----------------------------------------------------------------
        const lineMat = new THREE.LineBasicMaterial({
          color: ORANGE,
          transparent: true,
          opacity: 0.55,
        });

        // Pairs designed to look like a hand-drawn network
        const connections: [number, number][] = [
          [0, 2], [1, 3], [2, 4], [3, 5], [4, 6], [5, 7],
          [6, 8], [7, 9], [8, 10], [9, 11],
          [0, 5], [3, 8], [6, 11],
        ];
        connections.forEach(([a, b]) => {
          const start = tokenWorldPositions[a].vec.clone();
          const end = tokenWorldPositions[b].vec.clone();
          start.x = tokenRadius + 0.05;
          end.x = tokenRadius + 0.05;
          const geo = new THREE.BufferGeometry().setFromPoints([start, end]);
          group.add(new THREE.Line(geo, lineMat));
        });

        // Endpoint dots — small glowing orange spheres at each token's edge
        const dotGeo = new THREE.SphereGeometry(0.058, 16, 16);
        const dotMat = new THREE.MeshStandardMaterial({
          color: ORANGE,
          emissive: ORANGE,
          emissiveIntensity: 0.75,
          metalness: 0.2,
          roughness: 0.3,
        });
        tokenWorldPositions.forEach((t) => {
          const dot = new THREE.Mesh(dotGeo, dotMat);
          dot.position.copy(t.vec);
          dot.position.x = tokenRadius + 0.05;
          group.add(dot);
        });

        // ----------------------------------------------------------------
        // ORBITING VALUE LABELS — billboarded so text always reads
        // ----------------------------------------------------------------
        const orbitRadius = 1.95;
        const valueMat = new THREE.MeshStandardMaterial({
          color: 0xffffff,
          metalness: 0.25,
          roughness: 0.55,
        });
        const valueAccentMat = new THREE.MeshStandardMaterial({
          color: ORANGE,
          emissive: ORANGE,
          emissiveIntensity: 0.5,
          metalness: 0.3,
          roughness: 0.5,
        });

        // Label sizing helper — long values get smaller text so they fit
        const sizeFor = (s: string) => {
          if (s.length > 20) return 0.105;
          if (s.length > 14) return 0.12;
          return 0.135;
        };

        valuesList.forEach((value, i) => {
          const n = valuesList.length;
          const angle = (i / n) * Math.PI * 2 + Math.PI / 2;
          const yOffset = ((i - (n - 1) / 2) * 0.55);

          const upper = value.toUpperCase();
          const valueGeo = new TextGeometry(upper, {
            font,
            size: sizeFor(upper),
            depth: 0.018,
            curveSegments: 6,
            bevelEnabled: false,
          });
          valueGeo.center();
          const valueMesh = new THREE.Mesh(valueGeo, valueMat);
          valueMesh.userData.isLabel = true;
          valueMesh.position.set(
            Math.cos(angle) * orbitRadius,
            yOffset,
            Math.sin(angle) * orbitRadius
          );
          valuesOrbit.add(valueMesh);
          labelMeshes.push(valueMesh);

          // Tiny orange accent dot beside each label (slightly inside orbit)
          const accentDot = new THREE.Mesh(
            new THREE.SphereGeometry(0.045, 12, 12),
            valueAccentMat
          );
          accentDot.position.set(
            Math.cos(angle) * (orbitRadius - 0.18),
            yOffset,
            Math.sin(angle) * (orbitRadius - 0.18)
          );
          valuesOrbit.add(accentDot);
        });

        // Slight initial 3-quarter tilt
        group.rotation.y = -0.22;
        group.rotation.x = -0.04;
      });

      // ----------------------------------------------------------------
      // CONTROLS — drag/touch rotation with damping
      // ----------------------------------------------------------------
      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.enableZoom = false;
      controls.enablePan = false;
      controls.rotateSpeed = 0.7;
      controls.autoRotate = !reduced;
      controls.autoRotateSpeed = 0.4; // slow + stately
      controls.minPolarAngle = Math.PI * 0.32;
      controls.maxPolarAngle = Math.PI * 0.68;

      controls.addEventListener("start", () => { controls.autoRotate = false; });
      let resumeTimer: number | undefined;
      controls.addEventListener("end", () => {
        if (reduced) return;
        if (resumeTimer) window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { controls.autoRotate = true; }, 3500);
      });

      const onResize = () => {
        const { w, h } = getSize();
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
      };
      window.addEventListener("resize", onResize);

      // Reusable vectors for billboarding
      const labelWorldPos = new THREE.Vector3();
      const billboardTarget = new THREE.Vector3();

      const animate = () => {
        // Values orbit independently around the column
        if (!reduced) {
          valuesOrbit.rotation.y += 0.003;
        }
        // Billboard: every value label faces the camera (Y-axis-locked
        // so text stays upright). This kills any mirroring as labels
        // travel around the orbit.
        for (const label of labelMeshes) {
          label.getWorldPosition(labelWorldPos);
          billboardTarget.set(camera.position.x, labelWorldPos.y, camera.position.z);
          label.lookAt(billboardTarget);
        }
        controls.update();
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      };
      animate();
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            observer.disconnect();
            init().catch((err) => console.warn("3D logo failed to init:", err));
            break;
          }
        }
      }, { rootMargin: "100px" });
      observer.observe(canvas);
    } else {
      init().catch(() => {});
    }
  }
</script>

<style>
  .hero-3d {
    background: var(--ink);
    color: var(--white);
    padding: 120px 0 96px;
    position: relative;
    overflow: hidden;
  }
  .hero-3d::before {
    content: "";
    position: absolute;
    right: -180px;
    top: -120px;
    width: 600px;
    height: 600px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(239, 90, 33, 0.30), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-3d::after {
    content: "";
    position: absolute;
    left: -200px;
    bottom: -200px;
    width: 480px;
    height: 480px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(64, 95, 110, 0.42), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-3d-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
  }
  @media (max-width: 900px) { .hero-3d-grid { grid-template-columns: 1fr; gap: 40px; } }

  .hero-headline { margin: 14px 0 0; }
  .lede { margin-top: 20px; max-width: 560px; }
  .cta-row { margin-top: 28px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }

  .hero-3d-side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .logo-3d-stage {
    position: relative;
    aspect-ratio: 1 / 1;
    background:
      radial-gradient(ellipse at center, rgba(239, 90, 33, 0.06) 0%, transparent 60%),
      linear-gradient(135deg, #050505 0%, #161616 100%);
    border: 1px solid var(--hairline);
    border-radius: 0;
    overflow: hidden;
  }
  #logo-3d-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  #logo-3d-canvas:active { cursor: grabbing; }

  .logo-3d-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    gap: 16px;
    color: var(--on-dark);
  }
  .fallback-letters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fallback-letters .tile {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    border-radius: 999px;
    font-size: 16px;
  }
  .fallback-letters .tile-orange { background: var(--orange); color: #fff; }
  .fallback-letters .tile-navy { background: #2c4a5b; color: #fff; }
  .fallback-values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .fallback-values li {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--muted);
    border: 1px solid var(--hairline);
    padding: 4px 10px;
  }
  .logo-3d-fallback .brand-expansion {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--orange);
    font-weight: 700;
    margin: 0;
  }

  .drag-hint {
    position: absolute;
    bottom: 14px;
    right: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    background: rgba(0, 0, 0, 0.55);
    padding: 6px 10px;
    border: 1px solid var(--hairline);
    backdrop-filter: blur(4px);
    pointer-events: none;
    z-index: 2;
  }

  .logo-tag {
    position: absolute;
    left: 14px;
    bottom: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--orange);
    font-weight: 700;
    pointer-events: none;
    z-index: 2;
  }

  .values-caption {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 600px) {
    .hero-3d { padding: 64px 0 56px; }
    .hero-3d::before { width: 360px; height: 360px; right: -120px; top: -80px; }
    .hero-3d::after { width: 320px; height: 320px; left: -120px; bottom: -120px; }
    .hero-3d-grid { gap: 32px; }
    .lede { margin-top: 16px; }
    .cta-row { margin-top: 22px; gap: 10px; }
    .drag-hint { font-size: 9px; padding: 4px 8px; }
    .logo-tag { font-size: 9px; letter-spacing: 1.5px; }
  }
</style>

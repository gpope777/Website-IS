---
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";
import type { Lang } from "@/lib/i18n";

export interface Props {
  eyebrow: string;
  headlineHtml: string;
  lede: string;
  signoff?: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  lang: Lang;
}

const { eyebrow, headlineHtml, lede, signoff, ctaPrimary, ctaSecondary, lang } = Astro.props;

const valores = (await getCollection("valores")).sort((a, b) => a.data.orden - b.data.orden);
const valoresLabel = lang === "es" ? "Cinco valores" : "Five values";
const dragHint = lang === "es" ? "Arrastra para girar" : "Drag to rotate";
const valuesList = valores.map((v) => (lang === "es" ? v.data.nombre_es : v.data.nombre_en));
---

<section class="hero-3d">
  <div class="aurora-layer" aria-hidden="true"></div>
  <div class="container hero-3d-grid">
    <div class="hero-3d-text">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 class="h1 h1-mixed-case hero-headline" set:html={headlineHtml} data-reveal data-reveal-delay="1" />
      <p class="lede" data-reveal data-reveal-delay="2">{lede}</p>
      {signoff && <span class="signoff" data-reveal data-reveal-delay="3">— {signoff}</span>}
      <div class="cta-row" data-reveal data-reveal-delay="4">
        <Button variant="primary" size="lg" href={ctaPrimary.href}>{ctaPrimary.label}</Button>
        {ctaSecondary && <Button variant="ghost" href={ctaSecondary.href}>{ctaSecondary.label}</Button>}
      </div>
    </div>

    <div class="hero-3d-side" data-reveal data-reveal-delay="2">
      <div class="logo-3d-stage">
        <canvas
          id="logo-3d-canvas"
          aria-label="Innovational · Talent Management Solutions — interactive 3D logo"
        ></canvas>
        <noscript>
          <div class="logo-3d-fallback">
            <div class="fallback-grid">
              {[
                ["i","n","n","o"],
                ["v","a","t","i"],
                ["o","n","a","l"],
              ].map((row, ri) => (
                <div class="fallback-row">
                  {row.map((l, ci) => (
                    <span class={`fallback-cell ${(ri + ci) % 2 === 0 ? "fc-orange" : "fc-navy"}`}>{l}</span>
                  ))}
                </div>
              ))}
            </div>
            <p class="brand-expansion"><span>talent</span> <em>management</em> <span>solutions</span></p>
          </div>
        </noscript>
        <span class="drag-hint" aria-hidden="true">{dragHint}</span>
      </div>

      <div class="values-thread" aria-label={valoresLabel}>
        <ol>
          {valuesList.map((v, i) => (
            <li>
              <span class="node" aria-hidden="true"></span>
              <span class="num">{i + 1}</span>
              <span class="name">{v}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById("logo-3d-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const init = async () => {
      const THREE = await import("three");
      const { OrbitControls } = await import("three/examples/jsm/controls/OrbitControls.js");
      const { FontLoader } = await import("three/examples/jsm/loaders/FontLoader.js");
      const { TextGeometry } = await import("three/examples/jsm/geometries/TextGeometry.js");

      const scene = new THREE.Scene();

      const getSize = () => {
        const rect = canvas.getBoundingClientRect();
        return { w: rect.width || 400, h: rect.height || 400 };
      };
      const { w, h } = getSize();

      const camera = new THREE.PerspectiveCamera(36, w / h, 0.1, 100);
      camera.position.set(0.4, 0.5, 7.6);
      camera.lookAt(0, 0, 0);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(w, h, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      // Shadows turned off — the canvas is transparent against the dark page
      // surface, so any cast shadow would render as invisible on top of #000.

      // Brand palette
      const ORANGE = 0xef5a21;
      const NAVY = 0x2c4a5b;

      // Lighting — three-point setup that pops the alternating letters
      scene.add(new THREE.AmbientLight(0xffffff, 0.6));
      const keyLight = new THREE.DirectionalLight(0xffffff, 1.4);
      keyLight.position.set(2.5, 5, 5);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0xff7740, 0.65);
      rimLight.position.set(-3, 2, -2);
      scene.add(rimLight);
      const fillLight = new THREE.DirectionalLight(0x6090ff, 0.32);
      fillLight.position.set(-2, -2, 3);
      scene.add(fillLight);

      // Master rotation group
      const group = new THREE.Group();
      scene.add(group);

      const loader = new FontLoader();
      loader.load("/fonts/helvetiker_bold.typeface.json", (font) => {
        // Material factory — chunky semi-matte with a hint of metalness
        const makeMat = (color: number) =>
          new THREE.MeshStandardMaterial({
            color,
            metalness: 0.28,
            roughness: 0.5,
          });

        const orangeMat = makeMat(ORANGE);
        const navyMat = makeMat(NAVY);

        // ----------------------------------------------------------------
        // INNOVATIONAL — letters arranged in a 4×3 block, lowercase,
        // each letter extruded individually with heavy bevels for the
        // chunky brand look. Color pattern hand-tuned to feel like the
        // 2D mark.
        // ----------------------------------------------------------------
        const grid: string[][] = [
          ["i", "n", "n", "o"],
          ["v", "a", "t", "i"],
          ["o", "n", "a", "l"],
        ];
        // Mirrors the actual logo's color rhythm, not a strict checkerboard
        const colorGrid: number[][] = [
          [ORANGE, NAVY,   NAVY,   ORANGE],
          [NAVY,   ORANGE, NAVY,   ORANGE],
          [ORANGE, NAVY,   ORANGE, NAVY  ],
        ];

        const letterTextOpts = {
          font,
          size: 0.85,
          depth: 0.32,
          curveSegments: 14,
          bevelEnabled: true,
          bevelThickness: 0.08,
          bevelSize: 0.06,
          bevelSegments: 10,
        };

        // Cursor-based packing — measure each letter's actual width and lay
        // them out so the block looks like the brand mark (letters touching)
        // instead of a uniform grid with awkward gaps for narrow letters.
        const gap = 0.06;
        const rowHeight = 0.8;
        const blockYOffset = 0.4;

        // Build all geometries up front so we can measure widths
        const rowGeos = grid.map((row) =>
          row.map((letter) => {
            const geo = new TextGeometry(letter, letterTextOpts);
            geo.computeBoundingBox();
            const bb = geo.boundingBox!;
            const width = bb.max.x - bb.min.x;
            geo.center();
            return { geo, width };
          })
        );

        grid.forEach((row, ri) => {
          const totalRowW =
            rowGeos[ri].reduce((sum, g) => sum + g.width, 0) +
            (row.length - 1) * gap;
          let xCursor = -totalRowW / 2;

          row.forEach((_letter, ci) => {
            const { geo, width } = rowGeos[ri][ci];
            const mat = colorGrid[ri][ci] === ORANGE ? orangeMat : navyMat;
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(
              xCursor + width / 2,
              ((grid.length - 1) / 2 - ri) * rowHeight + blockYOffset,
              0
            );
            group.add(mesh);
            xCursor += width + gap;
          });
        });

        // ----------------------------------------------------------------
        // NETWORK OVERLAY — thin lines + accent dots threading through
        // the letters, evoking the graph in the 2D mark
        // ----------------------------------------------------------------
        const lineMat = new THREE.LineBasicMaterial({
          color: NAVY,
          transparent: true,
          opacity: 0.85,
        });
        const dotMat = new THREE.MeshStandardMaterial({
          color: ORANGE,
          metalness: 0.3,
          roughness: 0.4,
          emissive: ORANGE,
          emissiveIntensity: 0.35,
        });
        const dotWhiteMat = new THREE.MeshStandardMaterial({
          color: 0xffffff,
          metalness: 0.1,
          roughness: 0.4,
        });
        const dotZ = 0.42; // sit on top of the letter faces

        // 4 anchor points and 3 lines connecting them — placed to thread
        // through the inside of the o's and across the block diagonally
        const anchors: [number, number][] = [
          [-0.6,  1.55],   // upper-left over the first n
          [ 1.4,  1.4 ],   // upper-right inside the o
          [ 1.4, -0.5 ],   // middle-right inside the i body
          [-0.7, -1.0 ],   // lower-left over o on bottom row
        ];
        const lineRoutes: [number, number][] = [
          [0, 2],
          [1, 3],
          [0, 3],
        ];
        lineRoutes.forEach(([a, b]) => {
          const start = new THREE.Vector3(anchors[a][0], anchors[a][1], dotZ);
          const end = new THREE.Vector3(anchors[b][0], anchors[b][1], dotZ);
          const geo = new THREE.BufferGeometry().setFromPoints([start, end]);
          group.add(new THREE.Line(geo, lineMat));
        });
        // Two-tone dots — outer orange ring + inner white core for depth
        anchors.forEach(([x, y]) => {
          const outer = new THREE.Mesh(new THREE.SphereGeometry(0.11, 20, 20), dotMat);
          outer.position.set(x, y, dotZ);
          group.add(outer);

          const inner = new THREE.Mesh(new THREE.SphereGeometry(0.05, 16, 16), dotWhiteMat);
          inner.position.set(x, y, dotZ + 0.07);
          group.add(inner);
        });

        // ----------------------------------------------------------------
        // TAGLINE — "talent management solutions" in three colored words
        // ----------------------------------------------------------------
        const tagOpts = {
          font,
          size: 0.2,
          depth: 0.07,
          curveSegments: 8,
          bevelEnabled: true,
          bevelThickness: 0.012,
          bevelSize: 0.008,
          bevelSegments: 3,
        };
        const buildWord = (text: string) => {
          const geo = new TextGeometry(text, tagOpts);
          geo.computeBoundingBox();
          const bb = geo.boundingBox!;
          return { geo, w: bb.max.x - bb.min.x };
        };
        const w1 = buildWord("talent");
        const w2 = buildWord("management");
        const w3 = buildWord("solutions");
        const space = 0.16;
        const totalTagW = w1.w + w2.w + w3.w + space * 2;
        let xCursor = -totalTagW / 2;
        const tagY = -1.5;

        const word1 = new THREE.Mesh(w1.geo, navyMat);
        word1.position.set(xCursor, tagY, 0);
        group.add(word1);
        xCursor += w1.w + space;

        const word2 = new THREE.Mesh(w2.geo, orangeMat);
        word2.position.set(xCursor, tagY, 0);
        group.add(word2);
        xCursor += w2.w + space;

        const word3 = new THREE.Mesh(w3.geo, navyMat);
        word3.position.set(xCursor, tagY, 0);
        group.add(word3);

        // 3-quarter starting view — never edge-on
        group.rotation.y = -0.18;
        group.rotation.x = -0.05;
      });

      // ----------------------------------------------------------------
      // CONTROLS — drag/touch to rotate, with damping + slow autorotate
      // ----------------------------------------------------------------
      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.enableZoom = false;
      controls.enablePan = false;
      controls.rotateSpeed = 0.7;
      controls.autoRotate = !reduced;
      controls.autoRotateSpeed = 0.35;
      controls.minPolarAngle = Math.PI * 0.34;
      controls.maxPolarAngle = Math.PI * 0.66;
      controls.minAzimuthAngle = -Math.PI * 0.5;
      controls.maxAzimuthAngle = Math.PI * 0.5;

      controls.addEventListener("start", () => { controls.autoRotate = false; });
      let resumeTimer: number | undefined;
      controls.addEventListener("end", () => {
        if (reduced) return;
        if (resumeTimer) window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { controls.autoRotate = true; }, 3500);
      });

      const onResize = () => {
        const { w, h } = getSize();
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
      };
      window.addEventListener("resize", onResize);

      const animate = () => {
        controls.update();
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      };
      animate();
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            observer.disconnect();
            init().catch((err) => console.warn("3D logo failed to init:", err));
            break;
          }
        }
      }, { rootMargin: "100px" });
      observer.observe(canvas);
    } else {
      init().catch(() => {});
    }
  }
</script>

<script>
  // ── Word-cycling animation ────────────────────────────────────────────
  // Reads <em data-words="w1.|w2.|w3."> and rotates through the list.
  // Uses an inline-grid stack so the container width stays stable.
  (function () {
    const headline = document.querySelector(".hero-headline");
    if (!headline) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    (headline.querySelectorAll("em[data-words]") as NodeListOf<HTMLElement>).forEach((em) => {
      const words = (em.dataset.words ?? "").split("|").filter(Boolean);
      if (words.length < 2) return;

      // Build stacked grid of word spans
      const wrap = document.createElement("span");
      wrap.className = "word-rotate";
      wrap.setAttribute("aria-live", "polite");

      words.forEach((word, i) => {
        const span = document.createElement("span");
        span.className = "wri" + (i === 0 ? " wri-active" : "");
        span.textContent = word;
        if (i === 0) span.setAttribute("aria-current", "true");
        wrap.appendChild(span);
      });

      em.textContent = "";
      em.appendChild(wrap);

      if (reduced) return; // honour prefers-reduced-motion

      let current = 0;
      const INTERVAL = 2200; // ms per word

      setInterval(() => {
        const items = wrap.querySelectorAll<HTMLElement>(".wri");

        // Exit: current word slides down + fades
        items[current].classList.remove("wri-active");
        items[current].classList.add("wri-exit");
        items[current].removeAttribute("aria-current");
        const exitIdx = current;
        setTimeout(() => items[exitIdx].classList.remove("wri-exit"), 500);

        // Advance
        current = (current + 1) % words.length;

        // Enter: next word slides in from above
        items[current].classList.add("wri-active");
        items[current].setAttribute("aria-current", "true");
      }, INTERVAL);
    });
  })();
</script>

<style>
  .hero-3d {
    background: var(--ink);
    color: var(--white);
    padding: 120px 0 96px;
    position: relative;
    overflow: hidden;
  }
  .hero-3d::before {
    content: "";
    position: absolute;
    right: -180px;
    top: -120px;
    width: 600px;
    height: 600px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(239, 90, 33, 0.30), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-3d::after {
    content: "";
    position: absolute;
    left: -200px;
    bottom: -200px;
    width: 480px;
    height: 480px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(64, 95, 110, 0.42), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-3d-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
  }
  @media (max-width: 900px) { .hero-3d-grid { grid-template-columns: 1fr; gap: 40px; } }

  .hero-headline { margin: 14px 0 0; }
  .lede { margin-top: 20px; max-width: 560px; }
  .cta-row { margin-top: 28px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }

  .hero-3d-side {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .logo-3d-stage {
    position: relative;
    aspect-ratio: 1 / 1;
    background: transparent;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }
  #logo-3d-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  #logo-3d-canvas:active { cursor: grabbing; }

  .logo-3d-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    gap: 16px;
    color: var(--on-dark);
  }
  .fallback-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fallback-row { display: flex; gap: 6px; }
  .fallback-cell {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
  }
  .fallback-cell.fc-orange { background: var(--orange); color: #fff; }
  .fallback-cell.fc-navy { background: #2c4a5b; color: #fff; }
  .logo-3d-fallback .brand-expansion {
    font-size: 13px;
    margin: 0;
    color: var(--muted);
  }
  .logo-3d-fallback .brand-expansion em {
    font-style: normal;
    color: var(--orange);
    font-weight: 700;
  }

  .drag-hint {
    position: absolute;
    bottom: 14px;
    right: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
    background: rgba(0, 0, 0, 0.55);
    padding: 6px 10px;
    border: 1px solid var(--hairline);
    backdrop-filter: blur(4px);
    pointer-events: none;
    z-index: 2;
  }

  /* Values thread — visually a continuation of the logo's network graph.
     A hairline runs through 5 two-tone nodes (orange ring + white core)
     that mirror the network dots inside the 3D mark, with the value
     index + name typeset below each node in editorial style. */
  .values-thread {
    margin-top: 4px;
    padding-top: 4px;
  }
  .values-thread ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    column-gap: 12px;
    position: relative;
  }
  /* Hairline threading through the centers of the 5 nodes */
  .values-thread ol::before {
    content: "";
    position: absolute;
    top: 5px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: var(--hairline);
    z-index: 0;
  }
  .values-thread li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  /* Two-tone network node — same motif as the 3D logo's network dots */
  .values-thread .node {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.4),
      0 0 12px rgba(239, 90, 33, 0.35);
    position: relative;
    flex-shrink: 0;
  }
  .values-thread .node::after {
    content: "";
    position: absolute;
    inset: 50%;
    width: 3px;
    height: 3px;
    margin: -1.5px;
    background: #fff;
    border-radius: 50%;
  }
  .values-thread .num {
    font-size: 10px;
    color: var(--orange);
    font-weight: 500;
    letter-spacing: 1.4px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin-top: -2px;
  }
  .values-thread .name {
    font-size: 11px;
    color: var(--body-strong);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.3;
    text-wrap: balance;
  }

  /* Tablet — relax columns but keep horizontal thread */
  @media (max-width: 900px) {
    .values-thread ol { column-gap: 10px; }
  }

  /* Mobile — flip to vertical thread: hairline runs vertical on the
     left, nodes stack down the side, value names align left */
  @media (max-width: 600px) {
    .values-thread ol {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding-left: 24px;
    }
    .values-thread ol::before {
      top: 5px;
      bottom: 5px;
      left: 4px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .values-thread li {
      flex-direction: row;
      align-items: baseline;
      text-align: left;
      gap: 10px;
    }
    .values-thread .node {
      position: absolute;
      left: -24px;
      top: 4px;
    }
    .values-thread .num {
      margin-top: 0;
    }
    .values-thread .name {
      font-size: 13px;
    }
  }

  @media (max-width: 600px) {
    .hero-3d { padding: 64px 0 56px; }
    .hero-3d::before { width: 360px; height: 360px; right: -120px; top: -80px; }
    .hero-3d::after { width: 320px; height: 320px; left: -120px; bottom: -120px; }
    .hero-3d-grid { gap: 32px; }
    .lede { margin-top: 16px; }
    .cta-row { margin-top: 22px; gap: 10px; }
    .drag-hint { font-size: 9px; padding: 4px 8px; }
  }

  /* ── Aurora background ─────────────────────────────────────────── */
  @keyframes aurora {
    from { background-position: 50% 50%, 50% 50%; }
    to   { background-position: 350% 50%, 350% 50%; }
  }

  .aurora-layer {
    position: absolute;
    inset: -10px;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* Static blurred gradient — very subtle aurora tint in the corner */
  .aurora-layer::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(100deg, #000 0%, #000 7%, transparent 10%, transparent 12%, #000 16%),
      repeating-linear-gradient(100deg, #3b82f6 10%, #a5b4fc 15%, #93c5fd 20%, #ddd6fe 25%, #60a5fa 30%);
    background-size: 300%, 200%;
    background-position: 50% 50%, 50% 50%;
    filter: blur(14px);
    opacity: 0.15;
    will-change: transform;
    mask-image: radial-gradient(ellipse at 100% 0%, black 10%, transparent 60%);
    -webkit-mask-image: radial-gradient(ellipse at 100% 0%, black 10%, transparent 60%);
  }

  /* Animated overlay — barely-there shimmer */
  .aurora-layer::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(100deg, #000 0%, #000 7%, transparent 10%, transparent 12%, #000 16%),
      repeating-linear-gradient(100deg, #3b82f6 10%, #a5b4fc 15%, #93c5fd 20%, #ddd6fe 25%, #60a5fa 30%);
    background-size: 200%, 100%;
    background-attachment: fixed;
    mix-blend-mode: difference;
    opacity: 0.12;
    animation: aurora 60s linear infinite;
  }

  /* ── Word-cycling animation ─────────────────────────────────────────── */
  /* :global() needed because these elements are created by JS at runtime,
     so Astro's scope hash isn't applied to them. */
  .hero-headline :global(.word-rotate) {
    display: inline-grid;
    vertical-align: baseline;
    overflow: hidden;
  }
  .hero-headline :global(.wri) {
    grid-column: 1;
    grid-row: 1;
    opacity: 0;
    transform: translateY(-0.45em);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-headline :global(.wri.wri-active) {
    opacity: 1;
    transform: translateY(0);
  }

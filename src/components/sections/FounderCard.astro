---
import Button from "@/components/ui/Button.astro";

export interface Cert {
  name: string;
  img: string;
}

export interface Props {
  photoSrc: string;
  photoAlt: string;
  nombre: string;
  rol: string;
  bio: string;
  certificaciones: Cert[];
  eyebrow?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { photoSrc, photoAlt, nombre, rol, bio, certificaciones, eyebrow = "Sobre el fundador", ctaLabel, ctaHref } = Astro.props;
---

<section class="founder">
  <div class="container founder-grid">
    <figure class="founder-photo" data-reveal>
      <img src={photoSrc} alt={photoAlt} loading="lazy" decoding="async" width="500" height="600" />
    </figure>
    <div class="founder-text">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 class="h2" style="margin-top: 8px;" data-reveal data-reveal-delay="1">{nombre}</h2>
      <p class="role" data-reveal data-reveal-delay="2">{rol}</p>
      <p class="bio" data-reveal data-reveal-delay="3">{bio}</p>
      {certificaciones.length > 0 && (
        <div class="certs" data-reveal data-reveal-delay="4">
          <span class="certs-label">Certificaciones</span>
          <div class="certs-grid">
            {certificaciones.map((c) => (
              <div class="cert-card" data-spotlight>
                <img src={c.img} alt={c.name} loading="lazy" width="100" height="100" />
                <span class="cert-name">{c.name}</span>
              </div>
            ))}
          </div>
        </div>
      )}
      {ctaLabel && ctaHref && (
        <div style="margin-top: 28px;" data-reveal data-reveal-delay="5">
          <Button variant="outline-light" href={ctaHref}>{ctaLabel}</Button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .founder { background: var(--canvas); padding: 96px 0; color: var(--on-dark); }
  .founder-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px; align-items: center; }
  @media (max-width: 900px) { .founder-grid { grid-template-columns: 1fr; gap: 32px; } }
  .founder-photo { border: 3px solid var(--orange); border-radius: 50%; overflow: hidden; aspect-ratio: 1 / 1; background: var(--surface-card); width: min(380px, 80vw); margin: 0 auto; }
  .founder-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .founder-text .h2 { text-transform: uppercase; }
  .role { font-style: normal; font-weight: 400; color: var(--orange); margin-top: 8px; text-transform: uppercase; letter-spacing: 1.5px; font-size: 13px; }
  .bio { color: var(--body-text); font-weight: 300; margin-top: 18px; max-width: 60ch; line-height: 1.7; }
  .certs { margin-top: 32px; }
  .certs-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @property --gradient-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes gradient-rotate {
    to { --gradient-angle: 360deg; }
  }
  .cert-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 16px 20px;
    border: 2px solid transparent;
    background-image:
      linear-gradient(var(--surface-card), var(--surface-card)),
      conic-gradient(
        from var(--gradient-angle, 0deg),
        #c8b8a0 0%,
        #EF5A21 37%,
        #ffb347 30%,
        #EF5A21 33%,
        #c8b8a0 40%,
        #c8b8a0 50%,
        #EF5A21 77%,
        #ffb347 80%,
        #EF5A21 83%,
        #c8b8a0 90%
      );
    background-clip: padding-box, border-box;
    background-origin: padding-box, border-box;
    animation: gradient-rotate 4s linear infinite;
    transition: transform 0.3s ease;
  }
  .cert-card:hover {
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-card { animation: none; border: 2px solid var(--orange); background: var(--surface-card); }
  }
  .cert-card img {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .cert-name {
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    color: var(--on-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.3;
  }
  @media (max-width: 600px) {
    .founder { padding: 56px 0; }
    .founder-grid { gap: 24px; }
    .bio { font-size: 15px; line-height: 1.65; margin-top: 14px; }
    .role { font-size: 11px; }
    .certs-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .cert-card { padding: 18px 8px 14px; gap: 10px; animation-duration: 5s; }
    .cert-card img { width: 64px; height: 64px; }
    .cert-name { font-size: 9px; letter-spacing: 0.5px; }
  }
</style>

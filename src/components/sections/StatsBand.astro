---
export interface Stat {
  num: string;
  label: string;
}

export interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="stats-band">
  <div class="container stats-grid">
    {stats.map((stat, i) => (
      <div class="stat" data-reveal data-reveal-delay={String(i + 1)}>
        <div class="num">{stat.num}</div>
        <div class="lbl" set:html={stat.label} />
      </div>
    ))}
  </div>
</section>

<style>
  .stats-band { background: var(--canvas); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); padding: 56px 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  @media (max-width: 700px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  .stat .num { font-size: 56px; font-weight: 700; letter-spacing: -0.02em; color: var(--orange); line-height: 1; }
  .stat .lbl { font-size: 11px; color: var(--muted); margin-top: 12px; line-height: 1.4; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }
  @media (max-width: 600px) {
    .stats-band { padding: 36px 0; }
    .stats-grid { gap: 20px 16px; }
    .stat .num { font-size: 40px; }
  }
</style>

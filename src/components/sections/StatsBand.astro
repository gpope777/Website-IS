---
export interface Stat {
  num: string;
  label: string;
}

export interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="stats-band">
  <canvas class="sparkles-canvas" aria-hidden="true"></canvas>
  <div class="stats-glow" aria-hidden="true"></div>
  <div class="container stats-grid">
    {stats.map((stat, i) => (
      <div class="stat" data-reveal data-reveal-delay={String(i + 1)}>
        <div class="num">{stat.num}</div>
        <div class="lbl" set:html={stat.label} />
      </div>
    ))}
  </div>
</section>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  (document.querySelectorAll(".sparkles-canvas") as NodeListOf<HTMLCanvasElement>).forEach((canvas) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const DENSITY = 100;
    interface P { x: number; y: number; s: number; o: number; sp: number; ph: number; }
    let particles: P[] = [];
    let raf = 0;
    let w = 0;
    let h = 0;

    const resize = () => {
      const rect = canvas.parentElement!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      particles = Array.from({ length: DENSITY }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        s: Math.random() * 1.4 + 0.4,
        o: Math.random() * 0.8 + 0.2,
        sp: Math.random() * 0.4 + 0.1,
        ph: Math.random() * Math.PI * 2,
      }));
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const p of particles) {
        const twinkle = (Math.sin(t * 0.001 * p.sp * 3 + p.ph) + 1) / 2;
        ctx.globalAlpha = twinkle * p.o;
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.s, 0, Math.PI * 2);
        ctx.fill();
        if (!reduced) {
          p.y -= p.sp * 0.12;
          p.x += Math.sin(t * 0.0004 + p.ph) * 0.08;
          if (p.y < -2) { p.y = h + 2; p.x = Math.random() * w; }
        }
      }
      raf = requestAnimationFrame(draw);
    };

    resize();
    raf = requestAnimationFrame(draw);
    window.addEventListener("resize", () => { cancelAnimationFrame(raf); resize(); raf = requestAnimationFrame(draw); });
  });
</script>

<style>
  .stats-band {
    position: relative;
    overflow: hidden;
    padding: 72px 0;
  }
  .sparkles-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .stats-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 110%, rgba(239, 90, 33, 0.15), transparent 55%);
    pointer-events: none;
    z-index: 0;
  }
  .stats-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  @media (max-width: 700px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  .stat .num { font-size: 56px; font-weight: 700; letter-spacing: -0.02em; color: var(--orange); line-height: 1; }
  .stat .lbl { font-size: 11px; color: var(--muted); margin-top: 12px; line-height: 1.4; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }
  @media (max-width: 600px) {
    .stats-band { padding: 48px 0; }
    .stats-grid { gap: 20px 16px; }
    .stat .num { font-size: 40px; }
  }
</style>

---
export interface Props {
  numero: string;
  nombre: string;
  descripcion: string;
}

const { numero, nombre, descripcion } = Astro.props;
---

<article class="value-card" data-reveal data-spotlight>
  <div class="value-num">{numero}</div>
  <h4>{nombre}</h4>
  <p>{descripcion}</p>
</article>

<style>
  .value-card {
    background: var(--surface-card);
    border: 1px solid var(--hairline);
    border-radius: 0;
    padding: 32px;
    position: relative;
    transition: border-color 0.2s ease, transform 0.3s ease;
  }
  .value-card:hover { border-color: var(--orange); transform: translateY(-2px); }
  .value-num {
    font-size: 12px;
    color: var(--orange);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .value-card h4 {
    font-size: 24px;
    margin: 16px 0 14px;
    color: var(--on-dark);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .value-card p { color: var(--body-text); line-height: 1.6; font-size: 15px; font-weight: 300; }
</style>

---
import { t, type Lang } from "@/lib/i18n";

export interface Props {
  href: string;
  titulo: string;
  resumen: string;
  fecha: Date;
  tiempoLectura: number;
  tags?: string[];
  imagenSrc?: string;
  imagenAlt?: string;
  lang: Lang;
  entrega: number;
  linkedinUrl?: string;
}

const { href, titulo, resumen, fecha, tiempoLectura, tags = [], imagenSrc, imagenAlt = "", lang, entrega } = Astro.props;
const fechaStr = fecha.toLocaleDateString(lang === "es" ? "es-PR" : "en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const lecturaLabel = tiempoLectura === 1 ? t("tiempoLectura.min", lang) : t("tiempoLectura.mins", lang);
---

<a href={href} class="article-card" data-reveal data-spotlight>
  {imagenSrc && (
    <div class="article-image">
      <img src={imagenSrc} alt={imagenAlt} loading="lazy" decoding="async" width="600" height="400" />
    </div>
  )}
  <div class="article-body">
    {typeof entrega === "number" && entrega > 0 && (
      <div class="entrega-tag">Publicación {entrega} <span>·</span> La Gran Pregunta</div>
    )}
    {tags.length > 0 && <div class="article-tags">{tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</div>}
    <h3>{titulo}</h3>
    <p>{resumen}</p>
    <div class="article-meta">
      <span>{fechaStr}</span>
      <span class="dot">·</span>
      <span>{tiempoLectura} {lecturaLabel}</span>
    </div>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: 1px solid var(--hairline);
    border-radius: 0;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.3s ease;
    text-decoration: none;
    color: inherit;
  }
  .article-card:hover { border-color: var(--orange); transform: translateY(-2px); }
  .article-image { aspect-ratio: 16 / 10; background: var(--surface-soft); }
  .article-image img { width: 100%; height: 100%; object-fit: cover; }
  .article-body { padding: 28px; flex: 1; display: flex; flex-direction: column; gap: 14px; }
  .article-tags { display: flex; gap: 8px; }
  .article-tags span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    background: transparent;
    color: var(--orange);
    padding: 4px 0;
    border: 0;
    font-weight: 700;
  }
  .article-card h3 { font-size: 24px; line-height: 1.2; color: var(--on-dark); font-weight: 700; letter-spacing: -0.01em; text-transform: uppercase; }
  .article-card p { font-size: 14px; color: var(--body-text); line-height: 1.6; font-weight: 300; }
  .article-meta { font-size: 11px; color: var(--muted); display: flex; gap: 8px; margin-top: auto; padding-top: 12px; text-transform: uppercase; letter-spacing: 1.2px; font-weight: 700; }
  .dot { opacity: 0.4; }
  .entrega-tag {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--orange);
    font-weight: 700;
  }
  .entrega-tag span { opacity: 0.5; margin: 0 4px; }

  @media (max-width: 600px) {
    .article-body { padding: 22px; gap: 12px; }
    .article-card h3 { font-size: 20px; line-height: 1.25; }
    .article-card p { font-size: 14px; }
  }
</style>

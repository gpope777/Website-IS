---
export interface Props {
  variant?: "primary" | "ghost" | "outline-light" | "outline-dark";
  size?: "md" | "lg";
  href?: string;
  type?: "button" | "submit";
  class?: string;
  disabled?: boolean;
}

const { variant = "primary", size = "md", href, type = "button", class: className, disabled } = Astro.props;
const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(" ");
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={disabled ? "true" : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 700;
    border-radius: 9999px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-family: var(--font-sans);
    position: relative;
    overflow: hidden;
  }
  .btn[disabled], .btn[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }

  /* Neon glow — gradient stripes at top & bottom edges */
  .btn::before,
  .btn::after {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 75%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--orange), transparent);
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .btn::before { top: 0; opacity: 0; }
  .btn::after  { bottom: 0; opacity: 0; }
  .btn:hover::before { opacity: 1; }
  .btn:hover::after  { opacity: 0.4; }

  /* Primary — white glow on orange bg */
  .btn--primary::before,
  .btn--primary::after {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
  }
  /* Ghost — text-only, no neon lines */
  .btn--ghost::before,
  .btn--ghost::after { display: none; }

  .btn--md { padding: 14px 28px; font-size: 13px; height: 48px; }
  .btn--lg { padding: 16px 32px; font-size: 14px; height: 52px; }

  .btn--primary { background: var(--orange); color: var(--on-dark); border: 1px solid var(--orange); }
  .btn--primary:hover { background: var(--orange-hover); border-color: var(--orange-hover); }

  .btn--ghost { color: var(--on-dark); padding-left: 4px; padding-right: 4px; letter-spacing: 1.5px; }
  .btn--ghost:hover { color: var(--orange); }

  .btn--outline-light { background: transparent; color: var(--on-dark); border: 1px solid var(--on-dark); }
  .btn--outline-light:hover { background: var(--on-dark); color: var(--canvas); }

  .btn--outline-dark { background: transparent; color: var(--on-dark); border: 1px solid var(--hairline); }
  .btn--outline-dark:hover { border-color: var(--on-dark); }
</style>

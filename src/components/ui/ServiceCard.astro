---
export interface Props {
  numero: string;
  territorio: string;
  titulo: string;
  resumen: string;
  herramientas?: string[];
}

const { numero, territorio, titulo, resumen, herramientas } = Astro.props;
---

<article class="service-card" data-reveal data-spotlight>
  <div class="service-num">{numero} <span class="separator">/</span> {territorio}</div>
  <h4>{titulo}</h4>
  <p>{resumen}</p>
  {herramientas && herramientas.length > 0 && (
    <div class="meta">{herramientas.join(" · ")}</div>
  )}
</article>

<style>
  .service-card {
    background: var(--surface-card);
    border: 1px solid var(--hairline);
    border-radius: 0;
    padding: 32px;
    transition: border-color 0.2s ease, transform 0.3s ease;
  }
  .service-card:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }
  .service-num {
    font-size: 12px;
    color: var(--muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .service-num .separator { color: var(--orange); margin: 0 6px; }
  .service-card h4 {
    font-size: 22px;
    margin: 16px 0 12px;
    color: var(--on-dark);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .service-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body-text);
    margin: 0;
    font-weight: 300;
  }
  .meta {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1.2px;
    text-transform: uppercase;
    font-weight: 700;
  }
</style>

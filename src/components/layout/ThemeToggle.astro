---
// Reads/writes data-theme on <html>. No props needed.
---

<button id="theme-toggle" class="theme-btn" type="button" aria-label="Toggle light/dark mode" title="Cambiar tema">
  <!-- Sun: visible in dark mode — click to switch to light -->
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <line x1="12" y1="2" x2="12" y2="5"/>
    <line x1="12" y1="19" x2="12" y2="22"/>
    <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/>
    <line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
    <line x1="2" y1="12" x2="5" y2="12"/>
    <line x1="19" y1="12" x2="22" y2="12"/>
    <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/>
    <line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon: visible in light mode — click to switch to dark -->
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--white);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.15s, border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .theme-btn:hover { opacity: 1; }

  /* Default: dark mode → show sun */
  .icon-sun  { display: block; }
  .icon-moon { display: none; }

  /* Light mode → show moon, update button colors */
  :global([data-theme="light"]) .icon-sun  { display: none; }
  :global([data-theme="light"]) .icon-moon { display: block; }
  :global([data-theme="light"]) .theme-btn {
    border-color: var(--border);
    color: var(--on-dark);
    opacity: 1;
  }
  :global([data-theme="light"]) .theme-btn:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
</style>

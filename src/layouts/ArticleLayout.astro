---
import BaseLayout from "./BaseLayout.astro";
import Nav from "@/components/layout/Nav.astro";
import Footer from "@/components/layout/Footer.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { t, type Lang } from "@/lib/i18n";

export interface Props {
  title: string;
  resumen: string;
  fecha: Date;
  autor: string;
  tiempoLectura: number;
  tags: string[];
  imagenSrc?: string;
  imagenAlt?: string;
  entrega: number;
  linkedinUrl: string;
}

const { title, resumen, fecha, autor, tiempoLectura, tags, imagenSrc, imagenAlt, entrega, linkedinUrl } = Astro.props;
const lang: Lang = "es";
const path = Astro.url.pathname;
const fechaStr = fecha.toLocaleDateString("es-PR", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: resumen,
  datePublished: fecha.toISOString(),
  author: { "@type": "Person", name: autor },
  publisher: { "@type": "Organization", name: "Innovational TMS" },
};
---

<BaseLayout title={`${title} · La Gran Pregunta`} description={resumen} lang={lang}>
  <JsonLd data={articleSchema} slot="head" />
  <Nav slot="nav" lang={lang} currentPath={path} />

  <article class="article-page">
    <div class="container-tight">
      <div class="article-header">
        <a href="/la-gran-pregunta" class="back-link">← La Gran Pregunta</a>
        <div class="series-marker">
          <span class="entrega">Entrega {String(entrega).padStart(2, "0")}</span>
          <span class="series-name">La Gran Pregunta</span>
        </div>
        <div class="tags">{tags.map((tag) => <span>{tag}</span>)}</div>
        <h1 class="h1">{title}</h1>
        <p class="lede">{resumen}</p>
        <div class="meta">
          <span>{t("articulo.por", lang)} {autor}</span>
          <span class="dot">·</span>
          <span>{fechaStr}</span>
          <span class="dot">·</span>
          <span>{tiempoLectura} {t("tiempoLectura.mins", lang)}</span>
        </div>
        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="linkedin-link">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.339 18.338v-7.16H5.96v7.16h2.379zM7.158 10.107a1.378 1.378 0 1 0 0-2.755 1.378 1.378 0 0 0 0 2.755zm11.183 8.232v-3.926c0-2.058-.439-3.64-2.842-3.64-1.155 0-1.93.633-2.247 1.234h-.032V10.95H11.78v7.388h2.378v-3.658c0-.964.183-1.897 1.376-1.897 1.176 0 1.193 1.1 1.193 1.959v3.596h2.378z"/></svg>
          <span>Lee la versión original en LinkedIn →</span>
        </a>
      </div>

      {imagenSrc && (
        <figure class="article-hero">
          <img src={imagenSrc} alt={imagenAlt ?? ""} loading="eager" />
        </figure>
      )}

      <div class="article-body">
        <slot />
      </div>

      <aside class="article-cta">
        <p>¿Esta pregunta resonó con algo de tu organización?</p>
        <a href="/contacto" class="btn-primary-inline">Cuéntame de tu organización →</a>
      </aside>
    </div>
  </article>

  <Footer slot="footer" lang={lang} currentPath={path} />
</BaseLayout>

<style>
  .article-page { padding: 96px 0; background: var(--canvas); }
  .back-link { font-size: 12px; color: var(--orange); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; }
  .back-link:hover { color: var(--orange-hover); }
  .tags { display: flex; gap: 8px; margin-top: 24px; flex-wrap: wrap; }
  .tags span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    background: transparent;
    color: var(--orange);
    padding: 4px 0;
    border: 0;
    font-weight: 700;
  }
  .article-page h1 { margin-top: 16px; }
  .article-page .lede { margin-top: 18px; color: var(--body-strong); }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 13px; color: var(--muted); margin-top: 18px; }
  .dot { opacity: 0.4; }

  .article-hero { margin: 48px 0; border-radius: 0; overflow: hidden; aspect-ratio: 16 / 9; }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; }

  .article-body { font-size: 18px; line-height: 1.75; color: var(--body-text); }
  .article-body :global(h2) { font-size: 28px; font-weight: 700; letter-spacing: -0.01em; margin: 48px 0 16px; color: var(--on-dark); border-top: 1px solid var(--hairline); padding-top: 32px; text-transform: uppercase; }
  .article-body :global(h3) { font-size: 22px; font-weight: 700; margin: 32px 0 12px; color: var(--on-dark); }
  .article-body :global(p) { margin: 0 0 20px; }
  .article-body :global(em) { font-style: normal; color: var(--orange); font-weight: 400; }
  .article-body :global(strong) { color: var(--on-dark); font-weight: 700; }
  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 20px 1.4em; list-style: disc; }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(li) { margin-bottom: 8px; }
  .article-body :global(a) { color: var(--orange); }

  .series-marker { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }
  .series-marker .entrega { color: var(--orange); }
  .series-marker .series-name { color: var(--muted); }
  .series-marker .series-name::before { content: ""; display: inline-block; width: 32px; height: 1px; background: var(--hairline); margin-right: 12px; vertical-align: middle; }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--on-dark);
    background: var(--surface-card);
    border: 1px solid var(--orange);
  }
  .linkedin-link:hover { background: var(--orange); color: var(--canvas); }
  .linkedin-link svg { flex-shrink: 0; }

  .article-cta {
    margin-top: 64px;
    padding: 28px;
    border-radius: 0;
    background: var(--surface-card);
    color: var(--on-dark);
    text-align: center;
    border: 1px solid var(--hairline);
  }
  .article-cta p { font-style: normal; font-size: 19px; margin-bottom: 18px; color: var(--body-strong); font-weight: 300; }
  .btn-primary-inline {
    display: inline-block;
    background: var(--orange);
    color: var(--white);
    padding: 16px 32px;
    border-radius: 0;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .btn-primary-inline:hover { background: var(--orange-hover); color: var(--white); }
</style>

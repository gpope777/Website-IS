---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/layout/Nav.astro";
import Footer from "@/components/layout/Footer.astro";
import Logo3DHero from "@/components/sections/Logo3DHero.astro";
import StatsBand from "@/components/sections/StatsBand.astro";
import ClientLogos from "@/components/sections/ClientLogos.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import FounderCard from "@/components/sections/FounderCard.astro";
import ArticleCard from "@/components/ui/ArticleCard.astro";
import ContactForm from "@/components/sections/ContactForm.astro";
import CalendlyButton from "@/components/ui/CalendlyButton.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";
import { t } from "@/lib/i18n";

const lang = "es";
const path = Astro.url.pathname;

const articulos = (await getCollection("articulos", (e) => e.data.publicado !== false))
  .sort((a, b) => a.data.entrega - b.data.entrega)
  .slice(-3)
  .reverse();
---

<BaseLayout
  title="Innovational TMS · Consultoría en Psicología I-O"
  description="Las decisiones sobre las personas se siguen tomando por corazonada. La psicología industrial-organizacional existe para reemplazar el feeling con método. Consultoría con más de quince años de experiencia."
  lang={lang}
>
  <Nav slot="nav" lang={lang} currentPath={path} transparent={true} />

  <Logo3DHero
    eyebrow="Consultoría · Psicología Industrial-Organizacional"
    headlineHtml={`Las decisiones sobre las personas se siguen tomando por <em data-words="corazonada.|impulso.|intuición.|inercia.|costumbre.|sesgo.|urgencia.|conveniencia.|presión.|rutina.|prejuicio.|opinión.|moda.">corazonada.</em><br>Nuestra firma se creó para reemplazar el feeling con método.`}
    lede="La rotación, el ausentismo y el burnout no son problemas de 'falta de talento'. Son consecuencias de decisiones que se tomaron sin método: descripciones de puesto improvisadas, entrevistas por intuición, primeros días sin diseñar. Aquí ofrezco rigor donde casi siempre hay corazonada."
    signoff="Dr. Alejandro J. Gómez Betancourt"
    ctaPrimary={{ label: t("cta.cuentame", lang) + " →", href: "/contacto" }}
    ctaSecondary={{ label: t("cta.lee_articulos", lang), href: "/la-gran-pregunta" }}
    lang={lang}
  />

  <ClientLogos
    heading="Confían en nosotros"
    logos={[
      { name: "Meridian Group" },
      { name: "Atlas Industries" },
      { name: "Vertex Health" },
      { name: "Pinnacle Financial" },
      { name: "NovaTech" },
      { name: "Sterling Partners" },
      { name: "Pacific Dynamics" },
      { name: "Summit Corp" },
    ]}
  />

  <section class="services-summary">
    <div class="container">
      <p class="eyebrow" data-reveal>Cómo trabajamos</p>
      <h2 class="h2 h2-mixed-case" data-reveal data-reveal-delay="1">Diagnóstico antes que receta. <em data-words="Siempre con evidencia.|Sin atajos.|Datos antes que opiniones.|Respaldado por investigación.">Siempre con evidencia.</em></h2>
      <p class="lede" style="margin-top:14px;margin-bottom:32px;">
        Cada organización tiene su propia cultura, sus propias fricciones y su propia historia.
        No traemos un paquete prearmado: empezamos por entender qué está pasando, y desde ahí diseñamos.
      </p>
      <ServicesGrid lang={lang} variant="summary" />
      <div style="margin-top:32px;">
        <Button variant="outline-dark" href="/servicios">Ver los 14 servicios →</Button>
      </div>
    </div>
  </section>

  <FounderCard
    photoSrc="/dr-gomez.jpg"
    photoAlt="Dr. Alejandro J. Gómez Betancourt"
    nombre="Dr. Alejandro J. Gómez Betancourt"
    rol="PhD · Psicólogo Industrial-Organizacional · Presidente y Senior Consultant"
    bio="Doctor en Psicología por la Universidad Albizu en Puerto Rico, especializado en la aplicación de método científico y principios psicológicos al ámbito laboral. Más de quince años liderando iniciativas de desarrollo organizacional, programas de liderazgo, gestión del desempeño, seguridad ocupacional, cambio organizacional, reclutamiento y selección, capacitación, gestión del talento, planificación de sucesión, diseño organizacional, y transformación cultural post-fusiones. Su enfoque holístico combina ciencia, estrategia y liderazgo para entregar soluciones que transforman organizaciones y mejoran la experiencia del empleado. Más de veinte años enseñando posgrado en universidades de Puerto Rico."
    certificaciones={[
      { name: "McKinsey Leadership", img: "https://images.credly.com/images/8c655bf0-3852-455d-a6f2-d39dd1dd1162/image.png" },
      { name: "Hogan Assessment", img: "https://images.credly.com/images/56294884-167b-4102-9eaf-c1b34ca93db6/image.png" },
      { name: "DISC", img: "https://images.credly.com/images/f851233d-fca7-41f4-a6bd-32bb19128ce8/image.png" },
    ]}
    ctaLabel="Conoce más sobre la firma"
    ctaHref="/sobre-nosotros"
  />

  <StatsBand
    stats={[
      { num: "15", label: t("stats.anos_hr", lang) },
      { num: "20", label: t("stats.anos_posgrado", lang) },
      { num: "3", label: t("stats.certificaciones", lang) },
      { num: "1", label: t("stats.phd", lang) },
    ]}
  />

  <section class="articles-preview">
    <div class="container">
      <p class="eyebrow" data-reveal>La Gran Pregunta</p>
      <h2 class="h2 h2-mixed-case" data-reveal data-reveal-delay="1">Una serie de <em data-words="preguntas incómodas|preguntas que transforman|cuestionamientos necesarios|temas que se evitan">preguntas incómodas</em><br>para líderes que no se conforman.</h2>
      <div class="articles-grid">
        {articulos.map((a) => (
          <ArticleCard
            href={`/la-gran-pregunta/${a.id}`}
            titulo={a.data.title}
            resumen={a.data.resumen}
            fecha={a.data.fecha}
            tiempoLectura={a.data.tiempoLectura}
            tags={a.data.tags}
            lang={lang}
            entrega={a.data.entrega}
            linkedinUrl={a.data.linkedinUrl}
          />
        ))}
      </div>
      <div style="margin-top:32px;">
        <Button variant="outline-dark" href="/la-gran-pregunta">Ver todos los artículos →</Button>
      </div>
    </div>
  </section>

  <section class="contact-preview">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow" data-reveal>Hablemos</p>
        <h2 class="h2 h2-mixed-case" data-reveal data-reveal-delay="1">¿Cómo podemos apoyar a tu compañía?</h2>
        <p class="lede" data-reveal data-reveal-delay="2" style="max-width:480px;">
          Si lo que necesitas es una conversación rápida, agenda 30 minutos.
          Si prefieres escribir, llena el formulario.
        </p>
        <div style="margin-top:24px;">
          <CalendlyButton label="Reserva 30 minutos →" variant="outline-light" />
        </div>
      </div>
      <div class="form-wrap">
        <ContactForm lang={lang} variant="compact" />
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} currentPath={path} />
</BaseLayout>

<style>
  .services-summary { background: var(--canvas); padding: 96px 0; border-top: 1px solid var(--hairline); }
  .articles-preview { background: var(--canvas); padding: 96px 0; border-top: 1px solid var(--hairline); }
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-top: 32px; }
  .contact-preview { background: var(--canvas); padding: 96px 0; border-top: 1px solid var(--hairline); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 32px; } }
  .form-wrap { background: var(--surface-card); padding: 40px; border-radius: 0; border: 1px solid var(--hairline); }
  @media (max-width: 600px) {
    .services-summary, .articles-preview, .contact-preview { padding: 56px 0; }
    .articles-grid { grid-template-columns: 1fr; gap: 16px; margin-top: 24px; }
    .form-wrap { padding: 24px; }
  }
</style>

---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/layout/Nav.astro";
import Footer from "@/components/layout/Footer.astro";
import FounderCard from "@/components/sections/FounderCard.astro";
import ValueCard from "@/components/ui/ValueCard.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";

const lang = "en";
const path = Astro.url.pathname;

const valores = (await getCollection("valores")).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout
  title="About · Innovational TMS"
  description="A boutique consulting firm led by Dr. Alejandro J. Gómez Betancourt, PhD in Industrial-Organizational Psychology."
  lang={lang}
>
  <Nav slot="nav" lang={lang} currentPath={path} />

  <header class="page-header">
    <div class="container">
      <p class="eyebrow" data-reveal>About</p>
      <h1 class="h1" data-reveal data-reveal-delay="1">A <em>boutique I-O psychology firm</em><br>based in Puerto Rico.</h1>
      <p class="lede" data-reveal data-reveal-delay="2">
        We work with leaders who understand that decisions about people are the most strategic
        decisions an organization makes — and those decisions deserve method, not improvisation.
      </p>
    </div>
  </header>

  <FounderCard
    eyebrow="About the founder"
    photoSrc="/dr-gomez.jpg"
    photoAlt="Dr. Alejandro J. Gómez Betancourt"
    nombre="Dr. Alejandro J. Gómez Betancourt"
    rol="PhD · Industrial-Organizational Psychologist · President & Senior Consultant"
    bio="Doctorate in Psychology from Albizu University in Puerto Rico, specialized in applying scientific method and psychological principles to the workplace. Over fifteen years leading initiatives in organizational development, leadership programs, performance management, occupational safety, organizational change, recruitment and selection, training, talent management, succession planning, organizational design, and post-merger cultural transformation. His holistic approach combines science, strategy, and leadership to deliver solutions that transform organizations and enhance the employee experience. Over twenty years teaching at the graduate level at universities in Puerto Rico, where he also serves as academic supervisor and dissertation director. He holds certifications in McKinsey Leadership, Hogan Assessment, DISC, and other assessment tools used in selection processes and organizational development."
    certificaciones={[
      { name: "McKinsey Leadership", img: "https://images.credly.com/images/8c655bf0-3852-455d-a6f2-d39dd1dd1162/image.png" },
      { name: "Hogan Assessment", img: "https://images.credly.com/images/56294884-167b-4102-9eaf-c1b34ca93db6/image.png" },
      { name: "DISC", img: "https://images.credly.com/images/f851233d-fca7-41f4-a6bd-32bb19128ce8/image.png" },
    ]}
  />

  <section class="identity">
    <div class="container">
      <div class="identity-grid">
        <div>
          <p class="eyebrow" data-reveal>Identity</p>
          <h2 class="h2 h2-mixed-case" data-reveal data-reveal-delay="1">Empathy, analytical rigor, <em>transformational leadership.</em></h2>
        </div>
        <div>
          <p class="lede">
            Our identity reflects the principles of industrial-organizational psychology —
            but also something personal: the conviction that people aren't resources to manage,
            they are the most strategic decision an organization makes every day.
          </p>
          <p class="lede" style="margin-top:14px;">
            We combine cutting-edge scientific research with practical expertise to revolutionize talent
            management practices. Our approach is rigorously scientific, data-driven, and always —
            always — evidence-based.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="focus">
    <div class="container">
      <div class="identity-grid">
        <div>
          <p class="eyebrow" data-reveal>Our focus</p>
          <h2 class="h2 h2-mixed-case" data-reveal data-reveal-delay="1">Empowering organizations <em>through effective talent management.</em></h2>
        </div>
        <div>
          <p class="lede">
            We work to help organizations achieve their strategic goals through effective talent
            management practices. We design tailored solutions — grounded in the latest research and
            best practices of industrial-organizational psychology — to drive sustainable growth
            and excellence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="values-section">
    <div class="container">
      <p class="eyebrow" data-reveal>Personality</p>
      <h2 class="h2 h2-mixed-case" data-reveal data-reveal-delay="1">Five words<br><em>that describe how we work.</em></h2>
      <p class="lede" style="margin-top:14px; max-width: 720px;" data-reveal data-reveal-delay="2">
        We incorporate the essence of innovation in every aspect of our practice. Guided by the
        principles of creativity, adaptability, forward-thinking and open-mindedness, our personality
        reflects:
      </p>
      <div class="values-grid">
        {valores.map((v) => (
          <ValueCard
            numero={String(v.data.orden)}
            nombre={v.data.nombre_en}
            descripcion={v.data.descripcion_en}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="container" style="text-align:center;">
      <h2 class="h2">Shall we talk?</h2>
      <p class="lede" style="margin: 16px auto 28px;">Thirty minutes is usually enough to know if I can help.</p>
      <Button variant="primary" size="lg" href="/en/contact">Book 30 minutes →</Button>
    </div>
  </section>

  <Footer slot="footer" lang={lang} currentPath={path} />
</BaseLayout>

<style>
  .page-header { background: var(--canvas); color: var(--on-dark); padding: 96px 0 64px; border-bottom: 1px solid var(--hairline); }
  .page-header .lede { margin-top: 20px; }
  .identity { background: var(--canvas); padding: 96px 0; border-top: 1px solid var(--hairline); }
  .identity-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 48px; }
  @media (max-width: 768px) { .identity-grid { grid-template-columns: 1fr; gap: 24px; } }
  .focus { background: var(--canvas); padding: 96px 0; border-top: 1px solid var(--hairline); }
  .values-section { background: var(--canvas); padding: 80px 0; border-top: 1px solid var(--hairline); }
  .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-top: 40px; }
  .cta-block { background: var(--canvas); padding: 80px 0 120px; border-top: 1px solid var(--hairline); }
  @media (max-width: 600px) {
    .page-header { padding: 56px 0 36px; }
    .identity, .focus { padding: 48px 0; }
    .values-section { padding: 48px 0; }
    .values-grid { grid-template-columns: 1fr; gap: 14px; margin-top: 28px; }
    .cta-block { padding: 56px 0 80px; }
  }
</style>
